#!/bin/sh
# Runs the fast test suite before each commit (see CONTRIBUTING.md).
# Enable once per clone:  git config core.hooksPath .githooks
# Skip in an emergency:   git commit --no-verify

# Nothing to test when only Markdown files are staged
if [ -z "$(git diff --cached --name-only --diff-filter=ACMRD | grep -v '\.md$')" ]; then
    exit 0
fi

cd "$(git rev-parse --show-toplevel)" || exit 1

if [ -x .venv/bin/python ]; then
    PYTHON=.venv/bin/python
elif [ -x .venv/Scripts/python.exe ]; then
    PYTHON=.venv/Scripts/python.exe
else
    PYTHON=$(command -v python3 || command -v python)
fi

echo "pre-commit: running the fast test suite (~1.5 min; skip with --no-verify)"
if ! "$PYTHON" -m pytest -q -x; then
    echo "pre-commit: tests failed - commit stopped." >&2
    exit 1
fi
